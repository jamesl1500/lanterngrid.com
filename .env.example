# Copy to .env at the repo root. Defaults match infra/docker-compose.yml.

# API
DATABASE_URL=postgresql+asyncpg://lanterngrid:lanterngrid@localhost:5434/lanterngrid
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Public URL of the web app (email links and the GitHub callback point here)
WEB_URL=http://localhost:3000

# Email: smtp sends through Mailpit locally (inbox at http://localhost:8025);
# console just logs messages. In production use Resend's SMTP (smtp.resend.com:587,
# SMTP_STARTTLS=true, username "resend", password = API key).
EMAIL_BACKEND=smtp
EMAIL_FROM=Lantern Grid <hello@lanterngrid.com>
SMTP_HOST=localhost
SMTP_PORT=1025

# GitHub sign-in (optional). Create an OAuth app at https://github.com/settings/developers
# with callback URL http://localhost:3000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Uploads go straight from the browser to S3-compatible storage (MinIO locally).
# In production use Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com,
# region "auto", an R2 API token's keys, and the bucket's public URL (r2.dev or a custom
# domain). The bucket also needs a CORS rule allowing PUT from WEB_URL with the
# Content-Type header; see README.
# 127.0.0.1, not localhost, so the browser doesn't send localhost cookies to MinIO.
STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=lanterngrid-media
STORAGE_ACCESS_KEY=lanterngrid
STORAGE_SECRET_KEY=lanterngrid
STORAGE_PUBLIC_URL=http://127.0.0.1:9000/lanterngrid-media

# Web
API_URL=http://localhost:8000
