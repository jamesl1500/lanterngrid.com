{
  "name": "@lanterngrid/api",
  "private": true,
  "scripts": {
    "dev": "uv run uvicorn app.main:app --reload --port 8000",
    "lint": "uv run ruff check . && uv run ruff format --check .",
    "format": "uv run ruff format . && uv run ruff check --fix .",
    "typecheck": "uv run mypy app scripts",
    "test": "uv run pytest",
    "migrate": "uv run alembic upgrade head",
    "openapi": "uv run python -m scripts.export_openapi ../../packages/api-client/openapi.json"
  }
}
