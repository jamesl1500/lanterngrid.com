{
  "name": "lanterngrid",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write . && pnpm --filter @lanterngrid/api format",
    "gen:api": "pnpm --filter @lanterngrid/api openapi && pnpm --filter @lanterngrid/api-client generate",
    "services:up": "docker compose -f infra/docker-compose.yml up -d",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @lanterngrid/api migrate",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3"
  }
}
